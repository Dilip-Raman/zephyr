&i2c0 {
	smp_i2c: smp-i2c@55 {
		compatible = "zephyr,smp-i2c";
		reg = <0x55>;
		/* No DRDY GPIO, so the controller polls with 2-byte reads. */
	};
};

/* Enable buffered-mode in the emulator for buffer-mode path coverage */
&i2c0 {
	target-buffered-mode;
};
