#include <zephyr/dt-bindings/gpio/gpio.h>

/* FlexComm5 LPI2C5 used as the SMP I2C target. */
&flexcomm5_lpi2c5 {
	status = "okay";

	smp_i2c: smp-i2c@55 {
		compatible = "zephyr,smp-i2c";
		reg = <0x55>;
		data-ready-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
	};
};
